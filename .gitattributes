# Set default behavior, that will take care of different OS line endings
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized to LF line endings
*.php text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.conf text eol=lf
*.ini text eol=lf
.env* text eol=lf
Dockerfile* text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
